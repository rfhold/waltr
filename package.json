{
  "name": "waltr-workspace",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "pnpm --filter @rfhold/waltr-web build",
    "install:bundled": "cargo install --path crates/waltr-tui --bin waltr --features bundled --locked",
    "test": "pnpm --filter @rfhold/waltr-web test",
    "test:web:integration": "node scripts/test-web-integration.mjs --mode compose --access both",
    "test:web:integration:no-auth": "node scripts/test-web-integration.mjs --mode compose --access disabled",
    "test:web:integration:auth": "node scripts/test-web-integration.mjs --mode compose --access oidc",
    "test:web:trust": "node scripts/test-web-integration.mjs --mode compose --access oidc --script access/trust.browser.js",
    "test:web:integration:dev": "node scripts/test-web-integration.mjs --mode dev --access disabled",
    "test:web:live": "node scripts/test-web-integration.mjs --mode compose --access disabled --live",
    "test:web:screenshots": "node scripts/test-web-integration.mjs --mode compose --access disabled --screenshots",
    "test:web:screenshots:update": "node scripts/test-web-integration.mjs --mode compose --access disabled --screenshots --update-screenshots",
    "oauth:login": "node scripts/oauth-login-k6.mjs"
  },
  "devDependencies": {}
}
