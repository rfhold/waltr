{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "waltr": {
      "type": "remote",
      "url": "https://waltr.holdenitdown.net/mcp",
      "enabled": true
    },
    "waltr-local": {
      "type": "remote",
      "url": "http://127.0.0.1:14333/mcp",
      "oauth": false,
      "enabled": false
    },
    "waltr-preview": {
      "type": "remote",
      "url": "https://preview-waltr.holdenitdown.net/mcp",
      "enabled": false
    }
  }
}
