{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waltr",
  "version": "0.3.0",
  "identifier": "dev.waltr.app",
  "build": {
    "beforeBuildCommand": "pnpm --filter @rfhold/waltr-web build:tauri && node scripts/stage-web.mjs",
    "beforeDevCommand": "pnpm --filter @rfhold/waltr-web build:tauri:dev && node scripts/stage-web.mjs",
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://faro.holdenitdown.net; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
