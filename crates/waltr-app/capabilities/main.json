{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal IPC for the packaged Waltr main WebView.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "allow-start-runtime",
    "allow-dictation-start",
    "allow-dictation-finish",
    "allow-dictation-status",
    "allow-dictation-cancel",
    "allow-list-servers",
    "allow-save-server",
    "allow-remove-server",
    "allow-start-access-login",
    "allow-logout-access",
    "allow-client-dispatch",
    "allow-client-state",
    "allow-dispose-runtime",
    "allow-open-external-url",
    "allow-open-authorization-attempt"
  ]
}
