{
  "name": "@rfhold/waltr-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm wasm:build && pnpm dev:vite",
    "dev:vite": "vite --host 0.0.0.0",
    "build": "pnpm wasm:build && tsc --noEmit && vite build",
    "build:tauri": "pnpm wasm:build && tsc --noEmit -p tsconfig.tauri.json && vite build --mode tauri && node scripts/tauri-output.contract.mjs",
    "test": "node --test scripts/build-wasm.contract.mjs scripts/tauri-build.contract.mjs && vitest run --environment happy-dom",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:cleanup": "node scripts/build-wasm.mjs --cleanup"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@shikijs/core": "^4.2.0",
    "@shikijs/engine-javascript": "^4.2.0",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@solidjs/router": "0.16.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.2.0",
    "solid-js": "1.9.13",
    "unified": "^11.0.5",
    "virtua": "^0.49.1",
    "vite": "7.2.4",
    "vite-plugin-solid": "2.11.8"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@types/node": "24.10.1",
    "happy-dom": "20.9.0",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
